---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Not found" description="That page does not exist.">
  <section class="nf">
    <div class="shell">
      <h1>Not found</h1>
      <p class="lede">
        That page does not exist. The <a href={url('/work')}>case studies</a> are probably what you
        were after.
      </p>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(3rem, 10vw, 6rem); }
  .nf h1 { font-size: var(--step-3); margin-bottom: 1rem; }
</style>
