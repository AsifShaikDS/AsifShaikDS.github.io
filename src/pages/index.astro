---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, links, now, proof } from '../data/site';
import { focus } from '../data/focus';
import { projects } from '../data/projects';
import { url } from '../lib/url';

const featured = (await getCollection('work', (e) => !e.data.draft && e.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
const total = (await getCollection('work', (e) => !e.data.draft)).length;
---

<Base wide>
  <!-- Block 1: Hero -->
  <section class="hero">
    <div class="shell shell--wide hero__grid">
      <div class="hero__lead">
        <h1 class="hero__name">{site.name}</h1>
        <p class="hero__role">{site.role}</p>
        <p class="hero__intro">{site.headline}</p>
      </div>
      <div class="hero__aside">
      <p class="hero__tail">{site.intro}</p>
      <ul class="link-row hero__links">
        <li><a href={`mailto:${links.email}`}>{links.email}</a></li>
        <li><a href={links.github} rel="me noopener">GitHub</a></li>
        <li><a href={links.linkedin} rel="me noopener">LinkedIn</a></li>
        {links.resume && <li><a href={url(links.resume)}>Résumé</a></li>}
      </ul>
      </div>
    </div>
  </section>

  <!-- Block 2: Proof strip -->
  <section class="band" aria-label="At a glance">
    <div class="shell shell--wide">
      <ul class="proof">
        {proof.map((item) => (
          <li class="proof__item">
            <p class="eyebrow">{item.label}</p>
            <p class="proof__text">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Block 3: Selected work -->
  <section class="section">
    <div class="shell shell--wide">
      <h2 class="section__title">Selected work</h2>
      <p class="section__note muted">
        Each of these is written up the same way: what the system does, what was going wrong, and
        what changed once it was fixed. Almost none of this code is mine to publish, so these
        describe problems and outcomes rather than implementations.
      </p>
      <div class="work-list">
        {featured.map((entry) => (
          <WorkCard
            href={`/work/${entry.id}`}
            title={entry.data.title}
            summary={entry.data.summary}
            role={entry.data.role}
            period={entry.data.period}
            access={entry.data.access}
          />
        ))}
      </div>
      {total > featured.length && (
        <p class="section__more">
          <a class="arrow-link" href={url('/work')}>All {total} case studies</a>
        </p>
      )}
    </div>
  </section>

  <!-- Block 4: What I work on -->
  <section class="section">
    <div class="shell shell--wide">
      <h2 class="section__title">What I work on</h2>
      <div class="focus">
        {focus.map((item) => (
          <div class="focus__item">
            <h3 class="focus__title">{item.title}</h3>
            <p class="focus__body">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Block 5: In public -->
  <section class="section">
    <div class="shell shell--wide">
      <h2 class="section__title">In public</h2>
      <p class="section__note muted">
        Most of what I've built belongs to an employer or a client. These are the two things I'm
        rebuilding in the open, so the claims above are checkable rather than just stated.
      </p>
      <div class="work-list">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <!-- Block 6: Now / contact -->
  <section class="section section--last">
    <div class="shell shell--wide">
      <h2 class="section__title">Now</h2>
      <p class="now">
        <span class="now__date">Updated {now.updated}.</span> {now.text}
      </p>
      <p class="now__contact">
        If you're working on agent systems, retrieval, or anything where a model has to be trusted
        with a decision that's expensive to get wrong, write to me at{' '}
        <a href={`mailto:${links.email}`}>{links.email}</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(3.5rem, 11vw, 7rem) clamp(2.5rem, 7vw, 4rem);
  }
  .hero__name {
    font-size: var(--step-4);
    line-height: 1.02;
    letter-spacing: -0.028em;
    font-weight: 600;
  }
  /* The role is a label, not a sentence, so it is set like one. */
  .hero__role {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 1.1rem;
    font-weight: 500;
  }
  .hero__role::before {
    content: '';
    display: block;
    width: 2.25rem;
    border-top: 2px solid var(--accent);
    margin-bottom: 0.9rem;
  }
  .hero__grid { display: grid; gap: 2.5rem; }
  /* Below this the two columns would each be too narrow to set text in. */
  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 4rem;
      align-items: end;
    }
    .hero__aside { padding-bottom: 0.35rem; }
  }
  .hero__intro {
    margin-top: 1.5rem;
    font-size: var(--step-3);
    line-height: 1.22;
    letter-spacing: -0.02em;
    color: var(--text);
    text-wrap: balance;
  }
  .hero__tail {
    font-size: var(--step-0);
    line-height: 1.65;
    color: var(--text-soft);
  }
  .hero__links { margin-top: 1.75rem; }
  .hero__links a { overflow-wrap: anywhere; }

  .band {
    background: var(--bg-sunken);
    border-block: 1px solid var(--rule-soft);
    padding-block: 2rem;
  }
  .proof {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    .proof { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 2.5rem; }
  }
  .proof__text {
    margin-top: 0.3rem;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--text-soft);
  }

  .section { padding-block: clamp(2.5rem, 7vw, 4rem) 0; }
  .section--last { padding-bottom: 1rem; }
  .section__title {
    font-size: var(--step-2);
    margin-bottom: 0.6rem;
  }
  .section__note {
    font-size: var(--step-0);
    line-height: 1.6;
    max-width: var(--measure);
    margin-bottom: 1.75rem;
  }
  .section__more { margin-top: 1.5rem; font-size: var(--step--1); }

  .work-list { border-bottom: 1px solid var(--rule-soft); }

  .focus {
    display: grid;
    gap: 2rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 48rem) {
    .focus { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem 3rem; }
  }
  .focus__title {
    font-size: var(--step-0);
    margin-bottom: 0.5rem;
  }
  .focus__title::before {
    content: '';
    display: block;
    width: 1.75rem;
    border-top: 2px solid var(--accent);
    margin-bottom: 0.65rem;
  }
  .focus__body { color: var(--text-soft); font-size: var(--step--1); line-height: 1.6; }

  .now {
    max-width: var(--measure);
    color: var(--text-soft);
    margin-top: 1rem;
  }
  .now__date { color: var(--text); font-weight: 600; }
  .now__contact {
    max-width: var(--measure);
    margin-top: 1.25rem;
    color: var(--text-soft);
  }
</style>
