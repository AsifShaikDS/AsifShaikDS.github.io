---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

const entries = (await getCollection('work', (e) => !e.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Work"
  description="Case studies: LLM orchestration, agent latency, a state DOT permit workflow, and a regulatory compliance reviewer."
  wide
>
  <section class="page-head">
    <div class="shell shell--wide">
      <h1 class="page-head__title">Work</h1>
      <p class="lede">
        Written up the same way each time: what the system does, what was going wrong, and what
        changed once it was fixed. Almost none of this code is mine to publish, so these describe
        problems and outcomes rather than implementations. I'm glad to go deeper in conversation.
      </p>
    </div>
  </section>

  <section>
    <div class="shell shell--wide">
      <div class="work-list">
        {entries.map((entry) => (
          <WorkCard
            href={`/work/${entry.id}`}
            title={entry.data.title}
            summary={entry.data.summary}
            role={entry.data.role}
            period={entry.data.period}
            access={entry.data.access}
          />
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head { padding-block: clamp(2.5rem, 8vw, 4rem) 1.5rem; }
  .page-head__title { font-size: var(--step-3); margin-bottom: 1rem; }
  .work-list { border-bottom: 1px solid var(--rule-soft); }
</style>
