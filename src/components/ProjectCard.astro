---
import type { Project } from '../data/projects';
interface Props { project: Project }
const { project } = Astro.props;
const live = project.status === 'live' && project.href;
---

<article class="project">
  <h3 class="project__title">
    {live ? <a href={project.href} rel="noopener">{project.name}</a> : project.name}
    {!live && <span class="tag project__tag">Not published yet</span>}
  </h3>
  <p class="project__summary">{project.summary}</p>
  <p class="project__why muted">{project.why}</p>
</article>

<style>
  .project {
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule-soft);
  }
  .project__title {
    font-size: var(--step-0);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .project__tag { font-weight: 400; }
  .project__summary { color: var(--text-soft); max-width: var(--measure); }
  .project__why {
    font-size: var(--step--1);
    max-width: var(--measure);
    margin-top: 0.5rem;
  }
</style>
