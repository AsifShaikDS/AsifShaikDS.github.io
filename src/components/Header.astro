---
import { site } from '../data/site';
import { url } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');

// On the home page the wordmark sits directly above an <h1> saying the same
// thing, which reads as a mistake. It stays hidden there until you scroll past
// the hero, then fades in so the nav bar still identifies itself once the name
// has left the screen.
const isHome = path === '/';
---

<header class="site-head">
  <div class="shell shell--wide site-head__inner">
    <a class="site-head__name" href={url('/')} data-home={isHome ? '' : undefined}>{site.name}</a>
    <nav aria-label="Primary">
      <ul class="site-head__nav">
        {nav.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li><ThemeToggle /></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-head {
    border-bottom: 1px solid var(--rule-soft);
    background: var(--bg);
  }
  .site-head__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    flex-wrap: wrap;
  }
  .site-head__name {
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  /* Home only: hidden until the hero has scrolled away. `visibility` rather
     than `display` so the flex layout does not shift when it appears. */
  .site-head__name[data-home] {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.3rem);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s linear 0.25s;
  }
  :global(body.is-scrolled) .site-head__name[data-home] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-head__name[data-home] { transition: none; }
  }
  .site-head__nav {
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.78rem;
  }
  .site-head__nav a {
    text-decoration: none;
    color: var(--text-soft);
    padding-block: 0.25rem;
  }
  .site-head__nav a:hover { color: var(--text); }
  .site-head__nav a[aria-current='page'] {
    color: var(--text);
    box-shadow: inset 0 -1px 0 0 var(--accent);
  }
</style>

