---
import { site } from '../data/site';
import { url } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="site-head">
  <div class="shell shell--wide site-head__inner">
    <a class="site-head__name" href={url('/')}>{site.name}</a>
    <nav aria-label="Primary">
      <ul class="site-head__nav">
        {nav.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li><ThemeToggle /></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-head {
    border-bottom: 1px solid var(--rule-soft);
    background: var(--bg);
  }
  .site-head__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    flex-wrap: wrap;
  }
  .site-head__name {
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .site-head__nav {
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.78rem;
  }
  .site-head__nav a {
    text-decoration: none;
    color: var(--text-soft);
    padding-block: 0.25rem;
  }
  .site-head__nav a:hover { color: var(--text); }
  .site-head__nav a[aria-current='page'] {
    color: var(--text);
    box-shadow: inset 0 -1px 0 0 var(--accent);
  }
</style>
