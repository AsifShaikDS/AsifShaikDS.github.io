---
import Base from './Base.astro';

// Wrapper for plain markdown pages (src/pages/*.md). Add `layout: ../layouts/Page.astro`
// to a markdown file's frontmatter and it becomes a page. No component work needed.
interface Props {
  frontmatter: { title: string; description?: string; lede?: string };
}
const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="shell">
    <header class="page-head">
      <h1 class="page-head__title">{frontmatter.title}</h1>
      {frontmatter.lede && <p class="lede">{frontmatter.lede}</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
  </div>
</Base>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 8vw, 4rem) 1.75rem;
  }
  .page-head__title { font-size: var(--step-3); margin-bottom: 1rem; }
</style>
